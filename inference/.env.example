# Copy to inference/.env on the Jetson and edit the values.
# Never commit real credentials.
API_KEY=change-this-local-key
MODEL_PATH=/opt/pothole-detection/inference/best.pt
YOLO_DEVICE=cuda:0
CAMERA_TYPE=csi
CAMERA_DEVICE=0
CSI_SENSOR_ID=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
INFERENCE_WIDTH=640
INFERENCE_HEIGHT=640
IMAGE_SIZE=640
CONFIDENCE=0.25
DISPLAY=false
SAVE_COOLDOWN=5
LATEST_FRAME_INTERVAL=5
GNSS_PORT=/dev/ttyUSB0
GNSS_BAUD=9600
DB_PATH=/opt/pothole-detection/inference/potholes.db
UPLOADS_DIR=/opt/pothole-detection/inference/uploads
STATUS_PATH=/opt/pothole-detection/inference/local_status.json
LATEST_FRAME_PATH=/opt/pothole-detection/inference/uploads/latest.jpg
LOG_LEVEL=INFO
